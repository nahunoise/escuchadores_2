/* ============================================
   ESCUCHADOR — Design tokens
   ============================================ */
:root {
  /* Color */
  --color-sage: #a9b28d;       /* primary brand background (hero, closing sections) */
  --color-sage-dark: #8d9772;  /* borders / hover states on sage */
  --color-cream: #f7f5ee;      /* light content sections */
  --color-ink: #20241d;        /* primary text on light */
  --color-ink-soft: #4b4f42;   /* secondary text */
  --color-paper: #ffffff;      /* cards */

  /* Type */
  --font-display: "Fraunces", "Iowan Old Style", Georgia, serif;
  --font-body: "Inter", -apple-system, BlinkMacSystemFont, sans-serif;

  --step-eyebrow: 0.75rem;
  --step-body: 1rem;
  --step-h3: 1.35rem;
  --step-h2: 2rem;
  --step-h1: clamp(2.25rem, 4vw + 1rem, 3.75rem);

  /* Layout */
  --content-width: 1180px;
  --section-pad-y: clamp(3rem, 6vw, 6rem);
  --section-pad-x: clamp(1.25rem, 5vw, 3rem);
  --radius: 4px;
}

*,
*::before,
*::after {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  margin: 0;
  font-family: var(--font-body);
  color: var(--color-ink);
  background: var(--color-cream);
  line-height: 1.5;
  -webkit-font-smoothing: antialiased;
}

img {
  max-width: 100%;
  display: block;
}

a {
  color: inherit;
}

h1, h2, h3, h4 {
  font-family: var(--font-display);
  font-weight: 500;
  line-height: 1.15;
  margin: 0 0 0.6em;
}

p {
  margin: 0 0 1em;
}

ul {
  margin: 0;
  padding: 0;
  list-style: none;
}

.eyebrow {
  font-family: var(--font-body);
  font-size: var(--step-eyebrow);
  letter-spacing: 0.14em;
  text-transform: uppercase;
  font-weight: 600;
}

.wrap {
  max-width: var(--content-width);
  margin-inline: auto;
  padding-inline: var(--section-pad-x);
}

.section {
  padding-block: var(--section-pad-y);
}

.section--sage {
  background: var(--color-sage);
  color: var(--color-ink);
}

.section--cream {
  background: var(--color-cream);
}

.btn {
  display: inline-block;
  font-family: var(--font-body);
  font-size: 0.8rem;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  font-weight: 600;
  padding: 0.9em 1.8em;
  border: 1px solid var(--color-cream);
  border-radius: var(--radius);
  background: transparent;
  color: var(--color-cream);
  text-decoration: none;
  transition: background 0.2s ease, color 0.2s ease;
}

.btn:hover {
  background: var(--color-cream);
  color: var(--color-ink);
}

.btn--dark {
  border-color: var(--color-ink);
  color: var(--color-ink);
}

.btn--dark:hover {
  background: var(--color-ink);
  color: var(--color-cream);
}

.visually-hidden {
  position: absolute;
  width: 1px;
  height: 1px;
  overflow: hidden;
  clip: rect(0 0 0 0);
  white-space: nowrap;
}

:focus-visible {
  outline: 2px solid var(--color-ink);
  outline-offset: 2px;
}

@media (prefers-reduced-motion: reduce) {
  html {
    scroll-behavior: auto;
  }
  * {
    animation-duration: 0.01ms !important;
    transition-duration: 0.01ms !important;
  }
}