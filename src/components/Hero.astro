---
---

<section class="hero">
  <video
    class="hero__bg"
    autoplay
    muted
    loop
    playsinline
    preload="auto"
    poster="/images/hero-forest.jpg"
  >
    <source src="/videos/hero-loop.webm" type="video/webm" />
    <source src="/videos/hero-loop.mp4" type="video/mp4" />
  </video>
  <div class="hero__scrim" aria-hidden="true"></div>

  <div class="wrap hero__content">
    <p class="eyebrow">El sonido de la naturaleza, convertido en experiencia</p>
    <h1 class="hero__title">Así como hay miradores deben existir escuchadores.</h1>
    <a href="#servicios" class="btn">Activa tu escucha</a>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 92vh;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
    color: var(--color-cream);
  }

  .eyebrow {
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-weight: 600;
    color: var(--color-text-light);
  }
  .hero__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(10, 15, 8, 0.15) 0%, rgba(10, 15, 8, 0.55) 100%);
  }

  .hero__content {
    position: relative;
    z-index: 1;
    padding-block-end: clamp(3rem, 8vw, 6rem);
    max-width: 46rem;
    color: var(--color-white);
  }

  .hero__title {
    font-style: normal;
    font-size: clamp(2.75rem, 5.5vw, 4.25rem);
    max-width: 30ch;
    color: var(--color-text-light);
  }

  /* En mobile, priorizamos datos móviles: mostramos solo la imagen poster */
  @media (max-width: 640px) {
    .hero {
      background: url('/images/hero-forest.jpg') center/cover no-repeat;
    }
    .hero__bg {
      display: none;
    }
  }
</style>